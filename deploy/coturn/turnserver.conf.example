# coturn settings. Copy to turnserver.conf (never commit the filled-in copy).

listening-port=3478
tls-listening-port=5349

# the UDP range calls are relayed on; open it in the firewall (udp)
min-port=49160
max-port=49200

# this server's public address; behind NAT: <public ip>/<private ip>
external-ip=203.0.113.10

realm=turn.example.com
server-name=turn.example.com

# a fixed username and password, typed into Admin -> Telephony
fingerprint
lt-cred-mech
user=support:CHANGE-ME-long-random-password

# TLS for turns: (comment both out to run without it)
cert=/etc/letsencrypt/live/turn.example.com/fullchain.pem
pkey=/etc/letsencrypt/live/turn.example.com/privkey.pem

# never relay into this server's own private networks
no-multicast-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255

no-cli
log-file=stdout
